{
  "name": "gsf-ir-kts-extension",
  "displayName": "GSF IR KTS",
  "description": "KTS VS Code extension - Self-contained knowledge system with integrated backend",
  "version": "0.0.6",
  "publisher": "karmsud",
  "repository": {
    "type": "git",
    "url": "https://github.com/karmsud/gsf_ir_kts_agentic_system"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./extension.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "bundle:backend": "powershell -ExecutionPolicy Bypass -File ./scripts/bundle_backend.ps1",
    "package:vsix": "npm run bundle:backend && npx @vscode/vsce package",
    "package:vsix:no-deps": "npm run bundle:backend && npx @vscode/vsce package --no-dependencies"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "KTS Knowledge Assistant",
      "properties": {
        "kts.sourceFolder": {
          "type": "string",
          "default": "",
          "order": 1,
          "description": "Folder containing your documents (PSA, guides, manuals). Use 'KTS: Select Source Folder' to browse."
        },
        "kts.logLevel": {
          "type": "string",
          "default": "normal",
          "enum": [
            "normal",
            "verbose"
          ],
          "enumDescriptions": [
            "Show document counts, retrieval hits, and confidence scores.",
            "Full pipeline trace: graph hops, chunk scores, embedding calls, token counts."
          ],
          "order": 2,
          "description": "Output panel logging detail."
        },
        "kts.model": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "gpt-4.1",
            "gpt-4o",
            "gpt-4o-mini",
            "claude-sonnet-4"
          ],
          "enumDescriptions": [
            "Use your active GitHub Copilot model (recommended)",
            "OpenAI GPT-4.1 — strongest reasoning, 1M context",
            "OpenAI GPT-4o — balanced quality and speed",
            "OpenAI GPT-4o Mini — fast and lightweight",
            "Anthropic Claude Sonnet 4 — strong analysis"
          ],
          "order": 3,
          "description": "Language model for answer generation. 'auto' uses your active Copilot model."
        },
        "kts.backendMode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "venv",
            "exe"
          ],
          "order": 100,
          "markdownDescription": "**[Developer]** Backend execution: 'auto' (prefer exe), 'venv' (live Python), 'exe' (compiled)."
        },
        "kts.backendChannel": {
          "type": "string",
          "default": "bundled",
          "enum": [
            "bundled",
            "workspace"
          ],
          "order": 101,
          "markdownDescription": "**[Developer]** Backend source: 'bundled' (VSIX) or 'workspace' (git repo)."
        },
        "kts.pythonPath": {
          "type": "string",
          "default": "",
          "order": 102,
          "markdownDescription": "**[Developer]** Override Python executable path."
        },
        "kts.kbWorkspacePath": {
          "type": "string",
          "default": "",
          "order": 103,
          "markdownDescription": "**[Developer]** Override knowledge base workspace path."
        },
        "kts.ingestionTimeoutMinutes": {
          "type": "integer",
          "default": 60,
          "minimum": 5,
          "maximum": 180,
          "order": 104,
          "markdownDescription": "**[Developer]** Max time (minutes) for document ingestion."
        },
        "kts.knowledgeSourceRoot": {
          "type": "string",
          "default": "",
          "order": 4,
          "description": "Root directory for scope discovery (auto-set when source folder is selected)."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "kts.assistant",
        "name": "kts",
        "fullName": "KTS Knowledge Assistant",
        "description": "Retrieves enterprise knowledge context and citations from the local KTS backend.",
        "isSticky": true,
        "commands": [
          {
            "name": "search",
            "description": "Retrieve concise context and citations"
          },
          {
            "name": "deep",
            "description": "Retrieve more context chunks for complex issues"
          },
          {
            "name": "describe_images",
            "description": "Describe pending images using Copilot vision (fallback for auto-describe)"
          },
          {
            "name": "define",
            "description": "Look up a defined term and its closure chain"
          },
          {
            "name": "extract",
            "description": "Extract structured fields (parties, dates, amounts) from the current scope"
          },
          {
            "name": "compare",
            "description": "Compare a concept across multiple deals side-by-side"
          },
          {
            "name": "audit",
            "description": "Generate a topic-clustering audit with risk tags"
          },
          {
            "name": "summary",
            "description": "Generate a fixed 5-section deal summary"
          },
          {
            "name": "scope",
            "description": "List available knowledge scopes or target a specific scope"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "kts.selectSource",
        "title": "KTS: Select Source Folder"
      },
      {
        "command": "kts.crawl",
        "title": "KTS: Crawl"
      },
      {
        "command": "kts.ingest",
        "title": "KTS: Ingest"
      },
      {
        "command": "kts.crawlIngest",
        "title": "KTS: Crawl & Ingest"
      },
      {
        "command": "kts.status",
        "title": "KTS: Status"
      },
      {
        "command": "kts.search",
        "title": "KTS: Search"
      },
      {
        "command": "kts.doctor",
        "title": "KTS: Doctor (Diagnostics)"
      },
      {
        "command": "kts.openLogs",
        "title": "KTS: Open Logs"
      },
      {
        "command": "kts.viewStatus",
        "title": "KTS: View Status"
      },
      {
        "command": "kts.trainingPath",
        "title": "KTS: Training Path"
      },
      {
        "command": "kts.changeImpact",
        "title": "KTS: Change Impact"
      },
      {
        "command": "kts.freshnessAudit",
        "title": "KTS: Freshness Audit"
      },
      {
        "command": "kts.imageDescription",
        "title": "KTS: Image Description"
      },
      {
        "command": "kts.imageDescriptionComplete",
        "title": "KTS: Complete Image Descriptions"
      },
      {
        "command": "kts.refreshScopes",
        "title": "KTS: Refresh Knowledge Scopes"
      },
      {
        "command": "kts.runGoldenTests",
        "title": "KTS: Run Golden Answer Tests"
      },
      {
        "command": "kts.runTSGoldenTests",
        "title": "KTS: Run TS Guide Golden Tests"
      }
    ]
  }
}
