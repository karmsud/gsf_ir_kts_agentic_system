# =============================================================================
# .gitignore — GSF IR KTS Agentic System
# =============================================================================

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.log
*.pyo

# ── Python Virtual Environments ─────────────────────────────────────────────
.venv*/
venv/
env/
.env/

# ── Node.js ─────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log
yarn-error.log

# ── Build Artifacts (Root) ──────────────────────────────────────────────────
dist/
build/
*.spec
!packaging/*.spec
packaging/models/
packaging/build/
packaging/dist/

# ── Build Artifacts (Extension) ─────────────────────────────────────────────
extension/dist/
extension/bin/
extension/backend_bundle/
extension/out/
*.vsix
*.exe

# Intermediate build files
extension/server/
extension/webview-ui/build/

# ── IDE & Editor ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~

# ── MCP Debug Tools ─────────────────────────────────────────────────────────
.mcp-debug-tools/

# ── Generated Knowledge Bases & Workspace Data ─────────────────────────────
knowledge_base*/
.kts/
**/.kts/
test_kb/

# ── Project-Specific Output ─────────────────────────────────────────────────
audit_artifacts/*
!audit_artifacts/.gitkeep
data/*
!data/.gitkeep
accuracy_tuning_output*/
autopilot_run_*/
search_results_*.json
accuracy_scores_*.json
evidence_ledger_*.json
scripts/logs/
scripts/eval_results/
Incidents/logs/

# ── Binary / Serialized Data ────────────────────────────────────────────────
*.sqlite3
*.pickle
*.pkl
*.bin
*.onnx

# ── Test Runtime & Temporary Directories ────────────────────────────────────
kts_test_runtime_*/
MagicMock/
temp_crossencoder/
test_deal/
test/

# ── Test Output (generated results, not source) ────────────────────────────
tests/golden_answer_results/
tests/golden_results/
tests/golden_ts_guide_results/
tests/pytest_out.txt
tests/test_inv_output.txt
tests/ensemble_20.txt
tests/enterprise_test_results.json

# ── Ad-hoc Developer Scratch Files (top-level) ─────────────────────────────
/_*.py
/_*.txt

# ── Test & Debug Utilities (not part of test suite) ─────────────────────────
tests/_*.py
tests/_*.txt

# ── Test and Sample Data Directories ────────────────────────────────────────
kts_synthetic_corpus_v2/
kts_test_corpus/

# ── Archive Folders (historical documentation) ──────────────────────────────
**/archive/
docs/archive/
scripts/archive/

# ── Sample/Demo Data Folders ────────────────────────────────────────────────
Reference/
Release_Notes/
SOPs/
Training/
Troubleshooting/
User_Guides/
Configs/
prompts/
Architecture/
Incidents/

# ── Legacy Folders (removed from project) ───────────────────────────────────
networkX_graph/
source_1/
source_2/

# ── OS Files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Archives ────────────────────────────────────────────────────────────────
*.zip
*.tar.gz

# ── Pytest ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

